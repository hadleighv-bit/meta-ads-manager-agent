# ── Brand & site ─────────────────────────────────────────────────────────────
# Brand name shown everywhere on the page (placeholder until you decide).
NEXT_PUBLIC_BRAND_NAME=ORA
# Canonical URL of the deployed site (used for OG/meta tags).
NEXT_PUBLIC_SITE_URL=https://yourdomain.co.nz
# Instagram profile linked in the footer.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourbrand

# ── Klaviyo (email capture) ──────────────────────────────────────────────────
# Private API key (starts with pk_) from Klaviyo → Settings → API keys.
# Needs profile + list + subscription write scopes.
KLAVIYO_API_KEY=
# The ID of the Klaviyo list to subscribe signups to (Lists & Segments →
# your list → the ID is in the URL, e.g. "XyZ123").
KLAVIYO_LIST_ID=
# If both are empty, signups fall back to a local JSON file (data/signups.json)
# so the page still works end-to-end during development.

# ── Admin (/admin signups table + CSV export) ────────────────────────────────
# Password for the /admin route. If unset, /admin is disabled (all requests 401).
ADMIN_PASSWORD=

# ── Analytics (both optional; set one, both, or neither) ─────────────────────
# Plausible: the domain you registered in Plausible, e.g. yourdomain.co.nz
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
