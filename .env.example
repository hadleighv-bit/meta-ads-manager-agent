# ─── Meta (Facebook) App Credentials ─────────────────────────────────────────
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_access_token_here
# Include the act_ prefix, e.g. act_123456789
META_AD_ACCOUNT_ID=act_your_ad_account_id_here

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Agent Behaviour (optional) ───────────────────────────────────────────────
# Set to true to run with fake data — no Meta credentials required
MOCK_META=false
# Override the Claude model used by the analyst (default: claude-opus-4-6)
CLAUDE_MODEL=claude-opus-4-6

# ─── Email Reporting (optional — leave blank to disable) ──────────────────────
EMAIL_RECIPIENT=you@example.com
EMAIL_SENDER=reports@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
